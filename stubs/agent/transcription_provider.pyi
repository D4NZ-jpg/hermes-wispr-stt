# Type stub mirroring hermes-agent's agent/transcription_provider.py (Oct 2026) for offline type checking.
import abc
from typing import Any

class TranscriptionProvider(abc.ABC):
    @property
    @abc.abstractmethod
    def name(self) -> str: ...
    @property
    def display_name(self) -> str: ...
    def get_setup_schema(self) -> dict[str, Any]: ...
    def is_available(self) -> bool: ...
    def list_models(self) -> list[dict[str, Any]]: ...
    def default_model(self) -> str | None: ...
    @abc.abstractmethod
    def transcribe(
        self, file_path: str, *, model: str | None = None, language: str | None = None, **extra: Any
    ) -> dict[str, Any]: ...
    @property
    def streaming_capable(self) -> bool: ...
    def open_stream_session(
        self, *, language: str | None = None, prompt: str | None = None
    ) -> TranscriptionStreamSession: ...

class TranscriptionStreamSession(abc.ABC):
    @abc.abstractmethod
    def push_audio(self, chunk: bytes) -> None: ...
    @abc.abstractmethod
    def finalize(self) -> dict[str, Any]: ...
    def partial_transcript(self) -> str: ...
